  "traits": [
    {
      "name": "Tavernenraufbold",
      "text": "Dennis ist geübt im Umgang mit improvisierten Waffen. Seine waffenlosen Schläge verursachen 1W6 Wuchtschaden. Wenn er eine Kreatur mit einem waffenlosen Schlag oder einer improvisierten Waffe trifft, kann er als Bonusaktion versuchen, das Ziel zu greifen (Flucht-SG 13)."
    },
    {
      "name": "Betrunkene Fußarbeit",
      "text": "Wenn Dennis *\"Wirbelnde Schläge\"* einsetzt, erhält er die Vorteile von Flucht und seine Bewegungsgeschwindigkeit steigt bis zum Ende seines Zuges um 3 m."
    }
  ],
  "spellcasting": [],
  "actions": [
    {
      "name": "Multiangriff",
      "text": "Dennis macht 2 Angriffe."
    },
    {
      "name": "Waffenloser Schlag",
      "text": "*Nahkampfwaffenangriff:* +5, 1,5 m, 1 Ziel. *Treffer:* [[roll:1W6+3|6 (1W6 + 3)]] Wuchtschaden."
    },
    {
      "name": "Improvisierte Waffe (Flasche, Krug, Stuhlbein)",
      "text": "*Nahkampfwaffenangriff:* +5, 1,5 m, 1 Ziel, geworfen (6/18 m). *Treffer:* [[roll:1W6+3|6 (1W6 + 3)]] Wuchtschaden."
    }
  ],
  "bonus_actions": [
    {
      "name": "Wirbelnde Schläge (3/Tag)",
      "text": "Unmittelbar nachdem Dennis angegriffen hat, führt er einen zusätzlichen waffenlosen Schlag aus."
    }
  ],
  "reactions": [
    {
      "name": "Schwankender Ausweichschritt",
