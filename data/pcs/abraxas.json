    "features": {
      "class": [
        {
          "name": "Zauberwirken",
          "description": "Du bekommst alle Zauberplätze nach einer Langen Rast zurück. Bei jedem Levelaufstieg kannst du deine Zauber austauschen, außer deine immer vorbereiteten Zauber."
        },
        {
          "name": "Angeborenes Zauberwirken",
          "activation": "Bonusaktion",
          "duration": "1 Minute",
          "uses": "2",
          "recovery": {
            "long_rest": true
          },
          "effects": [
            "Zauberrettung-SG +1",
            "Vorteil auf alle Zauberangriffswürfe"
          ]
        },
        {
          "name": "Quelle der Magie",
          "resource": {
            "name": "Zaubereipunkte (ZP)",
            "max": 3,
            "recovery": {
              "long_rest": true
            }
          },
          "options": [
            {
              "name": "Zauberplatz zu ZP konvertieren",
              "effect": "Du kannst einen Zauberplatz verwenden, um ZP in Höhe des Zauberplatz-Levels zu erhalten."
            },
            {
              "name": "Zauberplatz erschaffen",
              "activation": "Bonusaktion",
              "effect": "Erschaffe bis zur nächsten Langen Rast einen Zauberplatz (Level 1 oder 2) durch Ausgeben von ZP.",
              "costs": [
                "2 ZP -> Zauberplatz Level 1",
                "3 ZP -> Zauberplatz Level 2"
              ]
            }
          ]
        },
        {
          "name": "Metamagie",
          "description": "Du kannst deine Zauber anpassen. Normalerweise nur eine Option pro Zauber (außer anders angegeben). Optionen können bei Levelaufstieg getauscht werden.",
          "options_known": [
            {
              "name": "Mächtiger Zauber",
              "cost": "1 ZP",
              "effect": "Wenn du Schaden für einen Zauber würfelst, kannst du bis zu 3 Schadenswürfel erneut würfeln; du musst die neuen Würfe nehmen.",
              "notes": [
                "Kann auch verwendet werden, wenn bereits eine andere Option auf den Zauber angewendet wurde."
              ]
            },
            {
              "name": "Suchender Zauber",
              "cost": "1 ZP",
              "effect": "Wenn du einen Zauber-Angriffswurf machst und verfehlst, kannst du den W20 erneut werfen; du musst den neuen Wurf nehmen.",
              "notes": [
                "Kann auch verwendet werden, wenn bereits eine andere Option auf den Zauber angewendet wurde."
              ]
            }
          ]
        }
      ],
