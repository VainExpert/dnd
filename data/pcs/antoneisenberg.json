        {
          "name": "Hochelfen-Herkunft",
          "description": "Zaubertrick der Magier (bei jeder Langen Rast tauschbar): aktuell „Magierhand“. Zusätzlich: „Magie entdecken“ 1/Lange Rast ohne Zauberplatz."
        }
      ],
      "class": [
        {
          "name": "Zauberwirken",
          "description": "Du bekommst alle Zauberplätze nach einer Langen Rast zurück. Nach jeder Langen Rast kannst du deine Zauber austauschen, außer deine immer vorbereiteten Zauber und Zaubertricks."
        },
        {
          "name": "Magisches Tüfteln",
          "description": "Über deinen Arkanen Fokus kannst du nicht-magischen Gegenständen einen von mehreren Effekten geben (Licht, Nachricht, Geruch/Geräusch, statisches Bild). Hält bis zur Aufhebung; bis zu 3 Gegenstände gleichzeitig."
        },
        {
          "name": "Das richtige Werkzeug für die Aufgabe",
          "description": "Mit Diebes- oder Handwerkswerkzeug kannst du magisch ein anderes Set Handwerkswerkzeug erschaffen (1 h); nicht-magisch; verschwindet bei erneuter Benutzung."
        },
        {
          "name": "Gegenstand durchdringen (Infusionen)",
          "description": "Nach jeder Langen Rast kannst du bis zu 2 nicht-magische Gegenstände mit Infusionen durchdringen; jede Zeit max. 1 Infusion pro Gegenstand; bei 3. Gegenstand endet die älteste; halten bis zu 3 Tage nach deinem Tod.",
          "infusions_known": [
            {
              "name": "Repliziere ein magisches Item",
              "details": "Du kannst einen „Nimmervollen Beutel“ erschaffen; kann erneut gewählt werden für ein anderes gewöhnliches magisches Item.",
              "notes": [
                "Einmal erstellt und an Tybald übergeben"
              ]
            },
            {
              "name": "Wiederholender Schuss",
              "details": "Berühre eine Waffe mit Munition-Eigenschaft: +1 auf Angriff/Schaden; ignoriert Laden; bei fehlender Munition erzeugt die Waffe temporäre magische Munition für einen Angriff.",
              "applied_to": "eigene Leichte Armbrust"
            },
            {
              "name": "Verstärkte Waffe",
              "details": "Berühre eine einfache oder Krieg-Waffe: +1 auf alle Angriffs- und Schadenswürfe."
            },
            {
              "name": "Verstärkte Verteidigung",
              "details": "Berühre ein Schild oder eine Rüstung: Träger erhält +1 RK."
            }
          ],
          "infused_items_listed": [
            "Leichte Armbrust, +1 (Inf)"
          ]
        }
      ],
      "subclass": [
        {
          "name": "Werkzeugsübung",
