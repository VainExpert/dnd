            {
              "name": "Schwächen (Langschwert)",
              "trigger": "Wenn du eine Kreatur mit deinem Langschwert triffst",
              "effect": "Das Ziel hat Nachteil auf seinen nächsten Angriffswurf vor dem Beginn deines nächsten Zuges."
            },
            {
              "name": "Verlangsamen (Wurfspeer)",
              "trigger": "Wenn du eine Kreatur mit deinem Wurfspeer triffst",
              "effect": "Bewegungsgeschwindigkeit des Ziels wird um 3 m bis zum Beginn deines nächsten Zuges reduziert (nicht stapelbar)."
            }
          ]
        },
        {
          "name": "Lanze (Spezial)",
