      "talents": [
        {
          "name": "Abfangen",
          "activation": "Reaktion",
          "effect": "Wenn eine Kreatur, die du sehen kannst, ein Ziel in 1,5 m Abstand zu dir mit einem Angriff trifft, reduzierst du den Schaden um 1d10 + Übungsbonus. Du musst ein Schild oder eine einfache/kriegswaffe halten."
        },
        {
          "name": "Wilder Angreifer",
          "effect": "Einmal pro Zug, wenn du ein Ziel mit einer Waffe triffst, kannst du den Schadenswürfel zweimal würfeln und einen der beiden Würfe verwenden."
        },
        {
          "name": "Waffenmeisterungen",
          "effect": "Du hast 2 Arten von Waffen deiner Wahl gemeistert. Du kannst eine der Meisterungen bei jeder Langen Rast tauschen.",
