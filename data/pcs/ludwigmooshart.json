    "features": {
      "class": [
        {
          "name": "Zauberwirken",
          "description": "Du bekommst alle Zauberplätze nach einer Langen Rast zurück. Nach jeder Langen Rast kannst du deine Zauber austauschen, außer deine Zaubertricks. Zaubertricks kannst du immer bei Levelaufstieg austauschen."
        },
        {
          "name": "Bardische Inspiration",
          "uses": "2",
          "recovery": {
            "long_rest": true
          },
          "activation": "Bonusaktion",
          "range": 18,
          "duration": "1 Stunde",
          "die": "1d6",
          "description": "Eine Kreatur deiner Wahl in Reichweite, die du sehen kannst, erhält einen Bardische-Inspiration-Würfel. Einmalig kann sie bei einem W20-Wurf den Würfel hinzufügen."
        },
        {
          "name": "Expertise",
          "description": "Du bist Experte in Auftreten und Motiv erkennen. Dein Übungsbonus wird für diese Fertigkeiten verdoppelt."
        },
        {
          "name": "Alleskönner",
          "description": "Du bekommst die Hälfte deines Übungsbonus auf alle Fertigkeitswürfe, bei denen du sonst nicht geübt bist."
        }
      ],
      "subclass": [
        {
          "name": "Schneidende Worte",
          "activation": "Reaktion",
          "range": 18,
          "cost": "1 Bardische Inspiration",
          "description": "Wenn eine Kreatur in Reichweite, die du sehen kannst, einen Schadenswurf macht oder bei einem Angriffs- oder Fähigkeitenwurf erfolgreich ist, wirfst du 1d6 und ziehst das Ergebnis vom Wurf der Kreatur ab.",
          "always_prepared_spells": []
        }
      ],
      "racial": [
        {
          "name": "Tapfer",
          "description": "Vorteil gegen Verängstigt werden oder sein."
        },
        {
          "name": "Halblingsgewandheit",
          "description": "Du kannst dich durch den Bereich jeder anderen Kreatur bewegen, die mindestens eine Größenklasse größer ist als du (du kannst dort aber nicht anhalten)."
        },
        {
          "name": "Glück",
          "description": "Wenn du mit einem W20 eine 1 würfelst, kannst du den Würfel erneut werfen und musst das neue Ergebnis nehmen."
        },
        {
          "name": "Angeborene Verstohlenheit",
          "description": "Du kannst die Verstecken-Aktion auch verwenden, wenn du nur hinter einer Kreatur bist, die mindestens eine Größenklasse größer ist als du."
        }
      ],
      "background": [
        {
          "name": "Routinen",
          "description": "Du kannst mit folgenden Routinen besonders gut auftreten: Instrumentalist, Geschichtenerzähler, Narr."
        },
        {
          "name": "Auf vielfachen Wunsch",
          "description": "Du findest immer einen Platz für einen Auftritt (Taverne, Herberge, Zirkus, ...). Dort bekommst du freie Übernachtungen und Essen, solange du jeden Abend dort auftrittst. Die Auftritte machen dich in der Umgebung bekannt, sodass du auf der Straße erkannt werden kannst."
        }
      ]
    },
