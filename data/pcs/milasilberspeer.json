          "options": [
            {
              "name": "Göttlicher Funke",
              "activation": "Magie-Aktion",
              "range": 9,
              "effect": "Zeige dein Heiliges Symbol auf eine Kreatur in Reichweite. Würfle 1d8 + WIS-Modifikator. Das Ziel erhält das Ergebnis als TP-Heilung ODER es macht einen CON-Rettungswurf. Bei Fehlschlag: Das Ergebnis als Strahlen- oder nekrotischer Schaden, bei Erfolg: halber Schaden. (Schaden steigt um +1d8 auf Stufe 7/13/18.)"
            },
            {
              "name": "Untote vertreiben",
              "activation": "Magie-Aktion",
              "range": 9,
              "area": "9 m Radius",
              "effect": "Alle Untoten im Radius machen einen WIS-Rettungswurf. Bei Fehlschlag: Verängstigt und kampfunfähig für 1 Minute; sie bewegen sich soweit wie möglich von dir weg. Endet vorzeitig, wenn die Betroffenen Schaden bekommen oder du kampfunfähig oder tot bist."
            },
            {
              "name": "Leben erhalten",
              "activation": "Magie-Aktion",
              "area": "9 m Umkreis",
              "effect": "Heile insgesamt 15 TP bei blutigen Kreaturen deiner Wahl im Umkreis (auch dich selbst). Du teilst die TP frei unter den Zielen auf."
            }
          ]
        }
