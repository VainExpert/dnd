    "features": {
      "class": [
        {
          "name": "Zauberwirken",
          "description": "Du bekommst alle Zauberplätze nach einer Langen Rast zurück. Bei jedem Levelaufstieg kannst du deine Zauber austauschen, außer deine immer vorbereiteten Zauber."
        },
        {
          "name": "Angeborenes Zauberwirken",
          "activation": "Bonusaktion",
          "duration": "1 Minute",
          "uses": "2",
          "recovery": {
            "long_rest": true
          },
          "effects": [
            "Zauberrettung-SG +1",
            "Vorteil auf alle Zauberangriffswürfe"
          ]
        },
        {
          "name": "Quelle der Magie",
          "resource": {
            "name": "Zaubereipunkte (ZP)",
            "max": 3,
            "recovery": {
              "long_rest": true
            }
          },
          "options": [
            {
              "name": "Zauberplatz zu ZP konvertieren",
              "effect": "Du kannst einen Zauberplatz verwenden, um ZP in Höhe des Zauberplatz-Levels zu erhalten."
            },
            {
              "name": "Zauberplatz erschaffen",
              "activation": "Bonusaktion",
              "effect": "Erschaffe bis zur nächsten Langen Rast einen Zauberplatz.",
              "costs": [
                "2 ZP -> Zauberplatz Level 1",
                "3 ZP -> Zauberplatz Level 2"
              ]
            }
          ]
        },
        {
          "name": "Metamagie",
          "description": "Du kannst deine Zauber für deine Bedürfnisse anpassen. Du kannst nur eine Option auf einen Zauber anwenden, außer wenn es in der Option anders beschrieben ist. Du kannst die Optionen bei einem Levelaufstieg austauschen.",
          "options_known": [
            {
              "name": "Suchender Zauber",
              "cost": "1 ZP",
              "effect": "Wenn du einen Zauber-Angriffswurf machst und verfehlst, kannst du 1 ZP nutzen, um den W20 erneut zu werfen. Du musst den neuen Wurf nehmen.",
              "notes": [
                "Kann auch verwendet werden, wenn du schon eine andere Option auf den Zauber anwendest."
              ]
            },
            {
              "name": "Subtiler Zauber",
              "cost": "1 ZP",
              "effect": "Wenn du einen Zauber wirkst, kannst du 1 ZP nutzen, um den Zauber ohne Verbale, Gestische oder nicht verbrauchte oder teure Material-Komponenten zu wirken."
            }
          ]
        }
      ],
      "subclass": [
        {
          "name": "Psionische Zauber",
          "always_prepared_spells": {
            "cantrip": [
              "Gedankensplitter"
            ],
            "level_1": [
              "Arme von Hadar",
              "Dissonantes Flüstern"
            ],
            "level_2": [
              "Gedanken wahrnehmen",
              "Gefühle besänftigen"
            ]
          }
        },
        {
          "name": "Telepathische Sprache",
          "activation": "Bonusaktion",
          "range": "3 km",
          "duration": "3 Minuten",
          "effect": "Du kannst eine telepathische Verbindung mit einer anderen Kreatur aufbauen und über eine Sprache kommunizieren, die ihr beide sprecht. Endet nach 3 Minuten oder wenn du eine neue Verbindung zu jemand anderem aufbaust.",
          "always_prepared_spells": []
        }
      ],
      "racial": [
